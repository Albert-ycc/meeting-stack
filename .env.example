# 复制为 .env 后按需修改。所有值都有默认，最少只需改归档根。
# 只有工作台自己读 .env：仓库根的 .env 和 workbench/.env 都会读，两处都写了的项以 workbench/.env 为准，
# 与从哪个目录启动无关。relay（watchdog、relayctl）、转写脚本、卡片监听都不读 .env，只认进程的环境变量，
# 要在启动命令里注入，例如在仓库根执行：
#   (set -a; source ./.env; set +a; exec python3 relay/quickstart/relay_watchdog.py)
# 用 source 导入时，值里有空格要加引号。

# ── 存储位置 ──────────────────────────────────────────────────────────────
# 正式归档根：会议音频与全部产物的最终位置。指向外置盘或 NAS 挂载点都行。
# 注意该目录应专用于会议资料，不要和普通文档目录混放。
MEETING_WORKBENCH_ARCHIVE_ROOT=~/MeetingArchive
MEETING_RELAY_ARCHIVE_ROOT=~/MeetingArchive

# 工作台状态目录：数据库、备份、波形缓存
MEETING_WORKBENCH_DATA_DIR=~/.meeting-workbench
# MEETING_WORKBENCH_BACKUP_RETENTION=14   # 备份留几份，本机和外置盘镜像各留这么多；最小 1，每份几百 MB；改小后下一次备份会清掉多出的旧副本
# relay 状态目录：已处理清单、派单存档、转写词典模板
# （单场热词快照不在这里，在任务队列数据库所在目录的 hotword-prompts/ 下）
MEETING_RELAY_STATE_DIR=~/.meeting-relay

# 转写产物工作目录（归档前的中间产物，归档后保留作原始档案）
MEETING_WORKBENCH_STAGING_ROOT=~/Movies/meeting-relay-products
MEETING_RELAY_PRODUCTS_ROOT=~/Movies/meeting-relay-products

# 任务队列数据库
MEETING_WORKBENCH_RELAY_JOBS_DB=~/.meeting-relay/workbench-jobs.sqlite3
MEETING_RELAY_JOBS_DB=~/.meeting-relay/workbench-jobs.sqlite3
# relay 组件的位置，默认是本仓库里的 relay/；relay 单独部署在别处时才改
# MEETING_WORKBENCH_RELAY_REPO=<本仓库>/relay

# ── Web 服务 ──────────────────────────────────────────────────────────────
MEETING_WORKBENCH_HOST=127.0.0.1
MEETING_WORKBENCH_PORT=8765
# 远程访问（tailscale serve）的域名；它的主机名会进 Host 白名单，只放行回环地址和这个名字
# MEETING_WORKBENCH_PUBLIC_BASE_URL=https://<本机>.ts.net
# 还要额外放行的主机名，逗号分隔、精确匹配
# MEETING_WORKBENCH_ALLOWED_HOSTS=
# 同一台机器上再跑一个实例（换个端口）时，两边要用不同的名字：浏览器的 cookie 不分端口，共用一个名字会互相覆盖令牌
# MEETING_WORKBENCH_CSRF_COOKIE_NAME=meeting_workbench_csrf
# 手工上传的单个录音大小上限（字节），默认 512 MiB；上传提示「录音大小无效或超过限制」时调大
# MEETING_WORKBENCH_MAX_JSON_UPLOAD_BYTES=536870912
# 服务日志文件；不设就照旧写标准输出和标准错误。设了以后访问、错误和应用自己的日志都写进它（每行带时间），
# 按大小轮转：单个文件超过 LOG_MAX_BYTES 字节（默认 20 MiB）就换新的，留 LOG_BACKUP_COUNT 份旧的（默认 5，至少 1）。
# 启动脚本别再把标准输出、标准错误重定向到同一个文件。
# MEETING_WORKBENCH_LOG_FILE=~/.meeting-workbench/logs/web.log
# MEETING_WORKBENCH_LOG_MAX_BYTES=20971520
# MEETING_WORKBENCH_LOG_BACKUP_COUNT=5

# ── 录音监听 ──────────────────────────────────────────────────────────────
# 放进这个目录的音频会自动进入流程，不校验来源。别用会落进不可信文件的目录（比如网页能自动下载到的目录），
# 专门建一个只放录音的目录最稳妥。
MEETING_RELAY_WATCH_DIR=~/Downloads

# relay 走工作台任务队列（受控模式）。必须是 1，relay 不读 .env，要以环境变量注入（见文件开头）。
# 不设时 watchdog 走旧同步路径：工作台入队的任务没人领；监听目录里短于 10 分钟的音频会被当成口述指令，
# 转写后直接派给 Agent 执行。
MEETING_RELAY_CONTROL_ENABLED=1

# ── 转写引擎 ──────────────────────────────────────────────────────────────
# observe = FunASR 出主稿 + Whisper 后台出对照稿（默认）。relay 自动处理录音（受控模式）只支持这一种：
#           交接要 FunASR 的说话人分组和结构化结果，发布要 Whisper 对照稿，只跑一个引擎时产物不全，
#           任务会在转写或发布环节失败。FunASR 环境缺失时脚本会自己回落成只跑 Whisper，结果一样是失败。
# funasr  = 只跑 FunASR ┐ 仅供单独手工跑 transcribe/transcribe.sh 时用，
# whisper = 只跑 Whisper ┘ 别在 relay 的环境里设
TRANSCRIBE_ENGINE=observe

# 两个引擎的位置。留空则从 PATH 探测。
# MEETING_RELAY_FUNASR_PYTHON=~/.venvs/funasr/bin/python
# MEETING_RELAY_WHISPER_BIN=~/.venvs/whisper/bin/whisper
# 转写脚本，默认用仓库内的 transcribe/transcribe.sh；单独部署时才指到别处
# MEETING_RELAY_TRANSCRIBE_SH=/绝对路径/transcribe.sh

# ── 纪要生成 ──────────────────────────────────────────────────────────────
# 派给哪个 Agent 写纪要：claude 或 codex
# 注意：这一步逐字稿文本会离开本机，见 README 的数据流边界说明
MEETING_RELAY_AGENT=claude
# Agent 为 claude 时用哪个模型后端：deepseek（默认，Agent 会话里要有 DEEPSEEK_API_KEY）或 claude
# MEETING_RELAY_LLM_BACKEND=deepseek
# MEETING_RELAY_CLAUDE_BIN=~/.local/bin/claude
# MEETING_RELAY_CODEX_BIN=~/.local/bin/codex

# Agent 跑在哪个 tmux session 里
MEETING_RELAY_TMUX_SOCKET=~/.tmux-socket/cc
MEETING_RELAY_TMUX_SESSION=agent

# 工作台写的词典快照，出纪要前按这场会从里面挑词
# MEETING_RELAY_GLOSSARY_SNAPSHOT=~/.meeting-workbench/glossary-snapshot.json

# ── 语义检索 ──────────────────────────────────────────────────────────────
# 本地嵌入模型，首次运行会下载到本机缓存，之后离线加载
MEETING_WORKBENCH_SEMANTIC_MODEL=BAAI/bge-small-zh-v1.5
MEETING_WORKBENCH_SEMANTIC_ENABLED=true

# ── 可选：Qwen3-ASR 影子转写 ───────────────────────────────────────────────
# 只用来和正式转写对照质量，不进正式流程。Apple Silicon 上 mlx-qwen3-asr 的位置，默认如下；
# 只读本机缓存、强制离线，运行期不会下载模型
# MEETING_WORKBENCH_QWEN_BINARY=~/.venvs/mlx-qwen3-asr/bin/mlx-qwen3-asr

# ── 可选：完成通知 ─────────────────────────────────────────────────────────
# relay 的转写/纪要进度通知。配了群就发群（lark-cli 以 bot 身份）；没配群时私聊 RELAY_LARK_USER_ID
# 这个 open_id。两个都留空才整个通知环节静默跳过，不影响主流程。
MEETING_RELAY_LARK_CHAT_ID=
RELAY_LARK_USER_ID=

# ── 可选：飞书通知与任务确认卡片 ───────────────────────────────────────────
# 纪要写好推「纪要写好」卡（纪要全文），任务抽取后推「会后任务确认」卡，逐条确认/驳回。
# 需要：一个飞书应用机器人（非自定义机器人）+ 本机 lark-cli 凭证 + 已订阅 card.action.trigger。
# 留空 LARK_CHAT_ID 则三次触达整体静默，任务确认在工作台网页内完成，不推飞书。
MEETING_WORKBENCH_LARK_CHAT_ID=
# 飞书 CLI 路径（凭证走 keychain）
MEETING_WORKBENCH_LARK_CLI_BIN=lark-cli
# 自建应用直连通道：app_id 与 secret 文件同时配上时直接调开放平台发卡片，不经 lark-cli
# MEETING_WORKBENCH_LARK_APP_ID=
# MEETING_WORKBENCH_LARK_APP_SECRET_FILE=~/.config/lark/app-secret
# 群自定义机器人的 webhook；上面配了应用机器人（LARK_CHAT_ID）就优先走应用机器人，两个都留空则整体静默
# MEETING_WORKBENCH_LARK_WEBHOOK_URL=
# 声档服务跑在 ssh→tmux（钥匙串锁定）里时，lark-cli 要经图形会话里的 tmux 转发：写那个 tmux 的套接字，默认如下
# MEETING_WORKBENCH_LARK_TMUX_SOCKET=~/.tmux-socket/cc
# 任务确认卡回调监听的事件目录（监听进程不读 .env，要以环境变量注入）。不设时
# task-notify/card_listener.py 用 ~/.meeting-stack/card-events，workbench/card_listener.py 用
# ~/.meeting-workbench/card-events
# MEETING_STACK_CARD_EVENTS_DIR=~/.meeting-stack/card-events

# ── 可选：任务抽取 ────────────────────────────────────────────────────────
# 纪要写好后由 LLM 抽取任务草稿。key 文件不存在则抽取自动跳过，不影响主流程。
# 注意：这一步纪要文本会离开本机
# MEETING_WORKBENCH_LLM_API_BASE=https://api.deepseek.com
# MEETING_WORKBENCH_LLM_API_KEY_FILE=~/.config/ds/api-key
# MEETING_WORKBENCH_LLM_MODEL=deepseek-chat
# 待确认草稿放多少天自动归入「已过期」；<=0 关闭
# MEETING_WORKBENCH_TASK_DRAFT_EXPIRE_DAYS=7
# 已确认、进行中的任务多少天没有状态变化也没有备注就算「停滞」（默认 3 天，页面上标出来，飞书也会督办）；
# 同一个任务两次督办至少隔几天（默认 2，最小 0.5）
# MEETING_WORKBENCH_TASK_STALL_AFTER_DAYS=3
# MEETING_WORKBENCH_TASK_STALL_COOLDOWN_DAYS=2

# ── 可选：项目材料目录 ─────────────────────────────────────────────────────
# 项目挂「材料根目录」、需求挂材料文件夹时，只能浏览这个目录之下
# MEETING_WORKBENCH_MATERIAL_BROWSE_ROOT=~
# 材料的正文、图片文字、录音文字在后台慢慢读，只留在本机；只有项目内问答在你确认「将发送 N 段材料原文给 …」后
# 才发出那几段；设成 false 只建文件名索引
# MEETING_WORKBENCH_MATERIAL_CONTENT_ENABLED=true
# 转写材料里的录音用哪个 FunASR Python；不设时跟 MEETING_RELAY_FUNASR_PYTHON 一样，再没有用 ~/.venvs/funasr/bin/python
# MEETING_WORKBENCH_FUNASR_PYTHON=~/.venvs/funasr/bin/python
# 超时（秒）：一张图认字；一份 PDF 多久没有新的一页；每段 10 分钟录音（实际取「音频长度 × 3」和它的较大者）
# MEETING_WORKBENCH_MATERIAL_IMAGE_TIMEOUT_S=60
# MEETING_WORKBENCH_MATERIAL_PDF_IDLE_TIMEOUT_S=60
# MEETING_WORKBENCH_MATERIAL_MEDIA_SEGMENT_TIMEOUT_S=900

# 第四期深度关联：两个后台循环（关掉后都不启动）；LINKS_LLM_ENABLED 关掉只跑本机的活，后台不调 AI
# MEETING_WORKBENCH_LINKS_ENABLED=true
# MEETING_WORKBENCH_LINKS_LLM_ENABLED=true
# 升级后往回补做多少天的会
# MEETING_WORKBENCH_LINKS_BACKFILL_DAYS=180
# 后台 AI 每天最多调几次；问答每天最多几个问题（0 表示关掉问答的 AI 回答）；问答一次最多等多少秒
# MEETING_WORKBENCH_LINKS_LLM_DAILY_CALLS=200
# MEETING_WORKBENCH_QA_DAILY_QUESTIONS=100
# MEETING_WORKBENCH_QA_TIMEOUT_SECONDS=90
# 相关材料的门槛（0.3 到 0.95）和领先第二名的最小差（0 到 0.3）
# MEETING_WORKBENCH_RELATED_FLOOR=0.60
# MEETING_WORKBENCH_RELATED_MARGIN=0.05
# 从材料里找词（记入前只在本机）
# MEETING_WORKBENCH_GLOSSARY_MINING_ENABLED=true
