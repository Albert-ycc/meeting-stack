<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.meeting-workbench.bootstrap</string>
  <key>ProgramArguments</key>
  <array>
    <string>__REPO_ROOT__/workbench/scripts/start-via-ssh.sh</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>StartInterval</key>
  <integer>300</integer>
  <key>StandardOutPath</key>
  <string>__HOME__/.meeting-workbench/logs/bootstrap.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/.meeting-workbench/logs/bootstrap.error.log</string>
</dict>
</plist>
