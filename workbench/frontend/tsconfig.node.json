{
  "compilerOptions": {
    "target": "ES2022",
    // 没有装 @types/node，配置文件里用到的 console 靠 DOM 的声明
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": []
  },
  "include": ["vite.config.ts"]
}
